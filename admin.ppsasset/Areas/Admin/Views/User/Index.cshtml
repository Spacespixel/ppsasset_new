@model IEnumerable<PPSAssetAdmin.Models.SyUser>

@{
    ViewData["Title"] = "User Management";
}

<h1>User Management</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New User</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Display Name</th>
            <th>Role</th>
            <th>Last Login</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
    <tr>
        <td>@item.Username</td>
        <td>@item.DisplayName</td>
        <td>@item.Role</td>
        <td>@item.LastLogin</td>
        <td>@item.IsActive</td>
        <td>
            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?');">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>
