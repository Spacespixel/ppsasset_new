                                                "ricco-town-wongwaen-lamlukka" => "townhome/thericcotown/wongwaen_lumlukka" 
                                            };
                                        }
                                        <a class="project-card__cta" href="/@projectUrl#register" target="_blank">More Detail</a>
                                    </footer>
                                </article>
                                }
