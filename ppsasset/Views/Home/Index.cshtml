@model List<PPSAsset.Models.ProjectViewModel>
@{
    ViewData["Title"] = "พูลผลทรัพย์ - บ้านเดี่ยว ทาวน์เฮ้าส์ คุณภาพ | The Ricco Residence & Town";
}

<link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css">
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="~/css/style-custom.css?v=@DateTime.Now.Ticks" rel="stylesheet">

<style>
/* Mourning Modal Styling */
.mourning-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85); /* Deep dark respectful overlay */
    z-index: 99999; /* Ensure it is on top of everything */
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.5s ease;
    backdrop-filter: blur(8px); /* Modern frosted glass look for the background */
}

.mourning-modal-overlay.active {
    opacity: 1;
}

.mourning-modal-content {
    background-color: #111; /* Sleek dark card background matching the theme */
    border: 1px solid #333;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    width: 90%;
    max-width: 680px; /* Wider card */
    max-height: 90vh; /* Fits comfortably within viewport */
    padding: 16px;
    text-align: center;
    transform: scale(0.9) translateY(20px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
}

.mourning-modal-overlay.active .mourning-modal-content {
    transform: scale(1) translateY(0);
}

.mourning-modal-body {
    width: 100%;
    max-height: 480px; /* Limit height so it doesn't get too big vertically */
    margin-bottom: 20px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    background-color: #0b0b0b; /* Respectful dark background for letterboxing */
    display: flex;
    justify-content: center;
    align-items: center;
}

.mourning-banner-img {
    max-width: 100%;
    max-height: 480px;
    width: auto;
    height: auto;
    object-fit: contain; /* Contain the square image without cropping or distorting */
    display: block;
}

.mourning-modal-footer {
    width: 100%;
}

.mourning-enter-btn {
    background: linear-gradient(135deg, #333333 0%, #111111 100%);
    color: #e0e0e0;
    border: 1px solid #555555;
    padding: 12px 28px;
    font-size: 15px;
    font-family: 'Prompt', 'Sarabun', sans-serif;
    font-weight: 500;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
    outline: none;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    width: 100%;
    letter-spacing: 0.5px;
}

.mourning-enter-btn:hover {
    background: linear-gradient(135deg, #444444 0%, #222222 100%);
    color: #ffffff;
    border-color: #777777;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.4);
    transform: translateY(-2px);
}

.mourning-enter-btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
}

/* Prevent body scrolling when modal is active */
body.modal-open {
    overflow: hidden;
    height: 100vh;
}
</style>

<!-- Mourning Tribute Popup Modal -->
<div id="mourning-modal" class="mourning-modal-overlay" style="display: none;">
    <div class="mourning-modal-content">
        <div class="mourning-modal-body">
            <img src="@Url.Content("~/images/mourning-banner.jpg")" alt="น้อมรำลึกในพระมหากรุณาธิคุณ" class="mourning-banner-img" />
        </div>
        <div class="mourning-modal-footer">
            <button id="close-mourning-btn" class="mourning-enter-btn">เข้าสู่เว็บไซต์ (Enter Website)</button>
        </div>
    </div>
</div>

<header id="page-header">
  
  
    <div class="hero-section background-is-dark">
        <div class="wrapper">
            <div class="hero-title">
                <div class="container">
                    <h1 class="animate hero-text-item" id="hero-main-title"></h1>
                     <div class="row">
                        <div class="col-md-8 col-sm-10">
                            <div class="animate">
                                <p class="hero-subtitle hero-text-item" id="hero-description">
                                  
                                </p>

                                <div class="hero-cta hero-text-item">
                                    <a href="#projects" class="btn-primary-cta">See More</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="owl-carousel" data-owl-dots="1" data-owl-nav="1" data-owl-autoplay="1" data-owl-loop="1" data-owl-fadeout="1">
            @if (Model != null && Model.Any())
            {
                @foreach (var project in Model.Take(5))
                {
                    <div class="hero-slide"
                         data-title="@project.NameTh"
                         data-subtitle="@project.Subtitle"
                         data-description="@project.Description"
